# Supabase PostgreSQL Database Connection URL
# Replace [YOUR-PASSWORD] with your actual Supabase database password.
# Use Session Pooler (port 5432) or Transaction Pooler (port 6543) or Direct Connection:
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Or Direct: postgresql://postgres:[password]@db.fqnjafaqupgkfehdlvsr.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:YOUR_SUPABASE_PASSWORD@db.fqnjafaqupgkfehdlvsr.supabase.co:5432/postgres

# Frontend Next.js API Target (Client-side URL)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Groq AI API Key for Chatbot (Optional)
NEXT_PUBLIC_GROQ_API_KEY=your_groq_api_key_here
